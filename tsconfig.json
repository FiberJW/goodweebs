{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "jsx": "react-native",
    "lib": ["dom", "esnext"],
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": true,
    "paths": {
      "yep/*": ["./*"]
    },
    "plugins": [
      {
        "name": "gql.tada/ts-plugin",
        "schema": "graphql.schema.json",
        "tadaOutputLocation": "graphql/graphql-env.d.ts"
      }
    ]
  },
  "extends": "expo/tsconfig.base",
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "dist",
    "**/*.test.ts"
  ]
}
