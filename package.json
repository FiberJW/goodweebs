{
  "main": "expo-router/entry",
  "scripts": {
    "start": "APP_VARIANT=development bunx expo start --tunnel -c",
    "web": "APP_VARIANT=development bunx expo start --web -c",
    "gql": "graphql-codegen --config codegen.ts && node tasks/trim-generated-graphql-exports.cjs",
    "i18n:collect": "fbtee collect --src . app components containers hooks screens",
    "i18n:prepare": "fbtee prepare-translations --locales ja_JP --output-dir translations",
    "i18n:translate": "fbtee translate --translations translations/*.json --output-dir i18n/translations",
    "i18n:sync": "bun run i18n:collect && bun run i18n:prepare && bun run i18n:translate",
    "lint": "eslint . --ext .ts,.js,.tsx --fix",
    "update:production": "bunx eas update --channel production --auto",
    "build:production": "bunx eas build --profile production --platform all --auto-submit",
    "build:development": "bunx eas build --profile development --platform all",
    "export:web": "bunx expo export --platform web",
    "android": "bunx expo run:android",
    "ios": "bunx expo run:ios"
  },
  "dependencies": {
    "@apollo/client": "^3.12.11",
    "@expo/metro-runtime": "~55.0.6",
    "@expo/ngrok": "^4.1.3",
    "@expo/react-native-action-sheet": "^4.0.1",
    "@logrocket/react-native": "^1.61.2",
    "@radix-ui/colors": "^3.0.0",
    "@sentry/react-native": "~7.11.0",
    "apollo3-cache-persist": "^0.15.0",
    "chroma-js": "^3.1.2",
    "date-fns": "^4.1.0",
    "eslint-config-expo": "~55.0.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "expo": "^55.0.2",
    "expo-application": "~55.0.8",
    "expo-auth-session": "~55.0.6",
    "expo-build-properties": "~55.0.9",
    "expo-checkbox": "~55.0.3",
    "expo-constants": "~55.0.7",
    "expo-dev-client": "~55.0.9",
    "expo-device": "~55.0.9",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.8",
    "expo-image": "~55.0.11",
    "expo-insights": "~55.0.10",
    "expo-linking": "~55.0.7",
    "expo-localization": "~55.0.8",
    "expo-router": "~55.0.2",
    "expo-secure-store": "~55.0.8",
    "expo-splash-screen": "~55.0.9",
    "expo-sqlite": "^55.0.10",
    "expo-system-ui": "~55.0.9",
    "expo-updates": "~55.0.11",
    "expo-web-browser": "~55.0.9",
    "fbtee": "^1.7.2",
    "graphql": "^16.10.0",
    "lodash": "^4.17.21",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-render-html": "^6.3.4",
    "react-native-root-siblings": "^5.0.1",
    "react-native-root-toast": "^3.6.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.2",
    "showdown": "^2.1.0",
    "vexo-analytics": "^1.5.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.1.1",
    "@graphql-codegen/introspection": "^5.0.0",
    "@graphql-codegen/typescript": "^5.0.7",
    "@graphql-codegen/typescript-operations": "^5.0.7",
    "@graphql-codegen/typescript-react-apollo": "^4.4.0",
    "@nkzw/babel-preset-fbtee": "^1.7.1",
    "@parcel/watcher": "^2.5.6",
    "@types/chroma-js": "^3.1.1",
    "@types/lodash": "^4.17.15",
    "@types/react": "~19.2.10",
    "@types/showdown": "^2.0.6",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.27.0",
    "eslint-plugin-react-doctor": "^0.5.8",
    "prettier": "^3.5.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "name": "goodweebs"
}
