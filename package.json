{
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "APP_VARIANT=development npx expo start --tunnel -c",
    "web": "APP_VARIANT=development npx expo start --web -c",
    "gql": "graphql-codegen --config codegen.yml",
    "lint": "eslint . --ext .ts,.js,.tsx --fix",
    "update:prod": "eas update --channel production --auto",
    "build:prod": "eas build --profile production --platform all --auto-submit",
    "build:dev": "eas build --profile development --platform all",
    "export:web": "npx expo export --platform web",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@apollo/client": "^3.12.11",
    "@expo/config-plugins": "~9.0.0",
    "@expo/metro-config": "~0.19.0",
    "@expo/metro-runtime": "~4.0.1",
    "@expo/ngrok": "^4.1.3",
    "@expo/react-native-action-sheet": "^4.0.1",
    "@radix-ui/colors": "^3.0.0",
    "@react-native-async-storage/async-storage": "^2.1.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "@sentry/react-native": "~6.3.0",
    "apollo3-cache-persist": "^0.15.0",
    "chroma-js": "^3.1.2",
    "date-fns": "^4.1.0",
    "expo": "^52.0.0",
    "expo-application": "~6.0.2",
    "expo-auth-session": "~6.0.3",
    "expo-constants": "~17.0.5",
    "expo-dev-client": "~5.0.11",
    "expo-device": "~7.0.2",
    "expo-font": "~13.0.3",
    "expo-haptics": "~14.0.1",
    "expo-insights": "~0.8.2",
    "expo-splash-screen": "~0.29.21",
    "expo-system-ui": "~4.0.8",
    "expo-updates": "~0.26.17",
    "expo-web-browser": "~14.0.2",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "lodash": "^4.17.21",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.7",
    "react-native-bouncy-checkbox": "^4.1.2",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-render-html": "^6.3.4",
    "react-native-root-toast": "^3.6.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "react-router-dom": "^7.1.5",
    "showdown": "^2.1.0",
    "title": "^3.4.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@graphql-codegen/cli": "^2.3.0",
    "@graphql-codegen/fragment-matcher": "1.17.8",
    "@graphql-codegen/introspection": "1.17.8",
    "@graphql-codegen/typescript": "1.17.8",
    "@graphql-codegen/typescript-operations": "1.17.8",
    "@graphql-codegen/typescript-react-apollo": "2.0.6",
    "@types/chroma-js": "^3.1.1",
    "@types/lodash": "^4.17.15",
    "@types/react": "~18.3.12",
    "@types/react-router-dom": "^5.3.3",
    "@types/showdown": "^2.0.6",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~12.0.0",
    "eslint": "^7.16.0",
    "eslint-config-universe": "^6.0.1",
    "eslint-plugin-react-native": "^3.10.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3"
  },
  "eslintConfig": {
    "ignorePatterns": [
      "graphql/generated.tsx",
      "dist/*",
      "web-build"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "react-native",
      "@typescript-eslint"
    ],
    "extends": [
      "plugin:react-native/all",
      "universe/native",
      "universe/shared/typescript-analysis"
    ],
    "overrides": [
      {
        "files": [
          "*.ts",
          "*.tsx",
          "*.d.ts"
        ],
        "parserOptions": {
          "project": "./tsconfig.json"
        }
      }
    ],
    "rules": {
      "react-native/no-inline-styles": 0,
      "react-native/no-raw-text": 0,
      "import/order": [
        "error",
        {
          "newlines-between": "always",
          "alphabetize": {
            "order": "asc"
          },
          "pathGroups": [
            {
              "pattern": "yep/**",
              "group": "external",
              "position": "after"
            }
          ],
          "pathGroupsExcludedImportTypes": [
            "builtin"
          ]
        }
      ]
    }
  },
  "private": true,
  "name": "goodweebs",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
