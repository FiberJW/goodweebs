{
  "main": "expo-router/entry",
  "scripts": {
    "start": "APP_VARIANT=development bunx expo start --tunnel -c",
    "web": "APP_VARIANT=development bunx expo start --web -c",
    "gql": "gql-tada generate output",
    "gql:schema": "gql-tada generate schema https://graphql.anilist.co --output graphql.schema.json",
    "gql:check": "gql-tada check",
    "typecheck": "tsc --noEmit",
    "i18n:collect": "fbtee collect --src . app components screens",
    "i18n:prepare": "fbtee prepare-translations --locales ja_JP --output-dir translations",
    "i18n:translate": "fbtee translate --translations translations/*.json --output-dir i18n/translations",
    "i18n:sync": "bun run i18n:collect && bun run i18n:prepare && bun run i18n:translate",
    "lint": "eslint . --ext .ts,.js,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.js,.tsx",
    "update:production": "bunx eas update --channel production --auto",
    "build:production": "bunx eas build --profile production --platform all --auto-submit",
    "build:development": "bunx eas build --profile development --platform all",
    "export:web": "bunx expo export --platform web",
    "android": "bunx expo run:android",
    "ios": "bunx expo run:ios"
  },
  "dependencies": {
    "@apollo/client": "3.12.11",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/react-native-action-sheet": "^4.0.1",
    "@logrocket/react-native": "^1.61.2",
    "@radix-ui/colors": "^3.0.0",
    "@sentry/react-native": "~8.28.0",
    "apollo3-cache-persist": "^0.15.0",
    "date-fns": "^4.1.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "expo": "~58.0.21",
    "expo-application": "~58.1.2",
    "expo-auth-session": "~58.0.16",
    "expo-build-properties": "~58.0.11",
    "expo-checkbox": "~58.0.2",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-insights": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-observe": "~58.0.16",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.19",
    "expo-web-browser": "~58.0.7",
    "fbtee": "^1.7.2",
    "gql.tada": "^1.11.2",
    "graphql": "^16.10.0",
    "lodash": "^4.17.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-render-html": "^6.3.4",
    "react-native-root-siblings": "^5.0.1",
    "react-native-root-toast": "4.0.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "showdown": "^2.1.0"
  },
  "devDependencies": {
    "@nkzw/babel-preset-fbtee": "^1.7.1",
    "@parcel/watcher": "^2.5.6",
    "@types/lodash": "^4.17.15",
    "@types/react": "~19.3.0",
    "@types/showdown": "^2.0.6",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.27.0",
    "eslint-plugin-react-doctor": "^0.5.8",
    "prettier": "^3.5.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "name": "goodweebs",
  "overrides": {
    "ws": "^8.12.1"
  }
}
