{
  "main": "expo-router/entry",
  "scripts": {
    "start": "APP_VARIANT=development bunx expo start --tunnel -c",
    "web": "APP_VARIANT=development bunx expo start --web -c",
    "gql": "gql-tada generate output",
    "gql:schema": "gql-tada generate schema https://graphql.anilist.co --output graphql.schema.json",
    "gql:check": "gql-tada check",
    "typecheck": "tsc --noEmit",
    "i18n:collect": "fbtee collect --src . app components containers hooks screens",
    "i18n:prepare": "fbtee prepare-translations --locales ja_JP --output-dir translations",
    "i18n:translate": "fbtee translate --translations translations/*.json --output-dir i18n/translations",
    "i18n:sync": "bun run i18n:collect && bun run i18n:prepare && bun run i18n:translate",
    "lint": "eslint . --ext .ts,.js,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.js,.tsx",
    "update:production": "bunx eas update --channel production --auto",
    "build:production": "bunx eas build --profile production --platform all --auto-submit",
    "build:development": "bunx eas build --profile development --platform all",
    "export:web": "bunx expo export --platform web",
    "android": "bunx expo run:android",
    "ios": "bunx expo run:ios"
  },
  "dependencies": {
    "@apollo/client": "3.12.11",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/ngrok": "^4.1.3",
    "@expo/react-native-action-sheet": "^4.0.1",
    "@logrocket/react-native": "^1.61.2",
    "@radix-ui/colors": "^3.0.0",
    "@sentry/react-native": "~7.11.0",
    "apollo3-cache-persist": "^0.15.0",
    "chroma-js": "^3.1.2",
    "date-fns": "^4.1.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "expo": "~57.0.21",
    "expo-application": "~57.0.2",
    "expo-auth-session": "~57.0.11",
    "expo-build-properties": "~57.0.17",
    "expo-checkbox": "~57.0.0",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-insights": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-observe": "~57.0.20",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "fbtee": "^1.7.2",
    "gql.tada": "^1.11.2",
    "graphql": "^16.10.0",
    "lodash": "^4.17.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-render-html": "^6.3.4",
    "react-native-root-siblings": "^5.0.1",
    "react-native-root-toast": "4.0.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "showdown": "^2.1.0",
    "vexo-analytics": "1.5.7"
  },
  "devDependencies": {
    "@nkzw/babel-preset-fbtee": "^1.7.1",
    "@parcel/watcher": "^2.5.6",
    "@types/chroma-js": "^3.1.1",
    "@types/lodash": "^4.17.15",
    "@types/react": "~19.2.10",
    "@types/showdown": "^2.0.6",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.27.0",
    "eslint-plugin-react-doctor": "^0.5.8",
    "prettier": "^3.5.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "name": "goodweebs",
  "overrides": {
    "ws": "^8.12.1"
  }
}
