{
  "main": "expo-router/entry",
  "scripts": {
    "start": "APP_VARIANT=development bunx expo start --tunnel -c",
    "web": "APP_VARIANT=development bunx expo start --web -c",
    "gql": "graphql-codegen --config codegen.ts",
    "i18n:collect": "fbtee collect --src app components containers hooks screens",
    "i18n:prepare": "fbtee prepare-translations --locales ja_JP --output-dir translations",
    "i18n:translate": "fbtee translate --translations translations/*.json --output-dir i18n/translations",
    "i18n:sync": "bun run i18n:collect && bun run i18n:prepare && bun run i18n:translate",
    "lint": "eslint . --ext .ts,.js,.tsx --fix",
    "update:production": "bunx eas update --channel production --auto",
    "build:production": "bunx eas build --profile production --platform all --auto-submit",
    "build:development": "bunx eas build --profile development --platform all",
    "export:web": "bunx expo export --platform web",
    "android": "bunx expo run:android",
    "ios": "bunx expo run:ios"
  },
  "dependencies": {
    "@apollo/client": "^3.12.11",
    "@expo/config-plugins": "~54.0.1",
    "@expo/metro-config": "~54.0.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/ngrok": "^4.1.3",
    "@expo/react-native-action-sheet": "^4.0.1",
    "@logrocket/react-native": "^1.61.2",
    "@radix-ui/colors": "^3.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "^7.5.0",
    "apollo3-cache-persist": "^0.15.0",
    "babel-plugin-react-compiler": "^19.0.0-beta-af1b7da-20250417",
    "chroma-js": "^3.1.2",
    "date-fns": "^4.1.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "expo": "^54.0.23",
    "expo-application": "~7.0.7",
    "expo-auth-session": "~7.0.8",
    "expo-build-properties": "~1.0.9",
    "expo-checkbox": "~5.0.8",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "^6.0.17",
    "expo-device": "~8.0.9",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-insights": "~0.10.7",
    "expo-linear-gradient": "~15.0.7",
    "expo-localization": "^17.0.8",
    "expo-router": "~6.0.14",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-system-ui": "~6.0.8",
    "expo-updates": "~29.0.12",
    "expo-web-browser": "~15.0.9",
    "fbtee": "^1.7.2",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "lodash": "^4.17.21",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-render-html": "^6.3.4",
    "react-native-root-siblings": "^5.0.1",
    "react-native-root-toast": "^3.6.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
