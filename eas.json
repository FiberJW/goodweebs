{
  "cli": {
    "version": ">=15.0.9",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "20.11.0",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "resourceClass": "medium"
      },
      "android": {
        "resourceClass": "medium"
      },
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "node": "20.11.0",
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "resourceClass": "medium"
      },
      "android": {
        "resourceClass": "medium"
      }
    },
    "production": {
      "node": "20.11.0",
      "autoIncrement": true,
      "channel": "production",
      "ios": {
        "resourceClass": "medium"
      },
      "android": {
        "resourceClass": "medium"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "changesNotSentForReview": true
      },
      "ios": {
        "ascAppId": "1515644560"
      }
    }
  }
}
